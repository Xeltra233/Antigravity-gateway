# Binaries
*.exe
*.exe~
*.dll
*.so
!android/app/src/main/jniLibs/**/*.so
# c-shared build side output, regenerated on every JNI build
android/app/src/main/jniLibs/**/*.h
*.dylib
/gateway

# Logs & Runtime Data
*.log
gateway.log
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Sensitive files & user credentials
api.txt
.env
test_out.txt

# Local private workspace (logs, tmp, assets, secrets) — never commit
/local/
# Local build output (run.bat falls back to bin/gateway.exe)
/bin/

# Goal artifacts & temporary test files
goal-*
AGENTS.md
test_bin.exe
icon_source.jpg

# Android
.gradle/
android/.gradle/
android/local.properties
android/*/build/
android/build/
android/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_

# Signing material (never commit)
android/keystore.properties
keystore.properties
*.jks
*.keystore
