# ==============================================================================
# Antigravity Gateway Configuration Example
# ==============================================================================

# [必需] 上游服务基址（只写根链接即可，网关会自动补齐 /v1 路径）
# 例如: https://api.openai.com 或 https://your-proxy-domain.com
UPSTREAM_BASE_URL=https://api.openai.com

# [必需] 上游 API 认证 Bearer Key（当 UPSTREAM_AUTH_MODE 为 bearer 时）
UPSTREAM_API_KEY=sk-your-upstream-api-key-here

# 上游认证模式：bearer 或 none（默认: bearer）
UPSTREAM_AUTH_MODE=bearer

# 上游单次请求超时时间（毫秒，默认: 120000 即 2分钟）
UPSTREAM_TIMEOUT_MS=120000

# 上游连接池配置
UPSTREAM_MAX_IDLE_CONNS=2048
UPSTREAM_MAX_IDLE_CONNS_PER_HOST=512
UPSTREAM_MAX_CONNS_PER_HOST=512

# [必需] 网关管理接口鉴权 Key（用于 /admin/keys 创建、列表、吊销下游 Key）
ADMIN_API_KEY=admin-secret-management-key-change-me

# [必需] 下游 Key HMAC-SHA256 签名密钥（至少16字符，不可泄露）
KEY_HMAC_SECRET=your-random-hmac-secret-at-least-16-bytes

# 动态下游 Key 存储 SQLite 数据库路径（默认: ./data/keys.sqlite）
KEY_DB_PATH=./data/keys.sqlite

# [推荐] 下游客户端访问 Key（酒馆 / curl 客户端填写的 API Key，与 DOWNSTREAM_KEYS_JSON 二选一）
API_KEY=sk-antigravity-123456

# 静态下游分发 Key（JSON 数组，纯环境变量部署多个 Key 时使用）
# DOWNSTREAM_KEYS_JSON=[{"id":"default-client","key":"sk-agw-default-static-key-12345","name":"Default Client"}]

# 网关监听地址与端口
HOST=0.0.0.0
PORT=8080

# 控制提示词角色：system 或 developer（默认: system）
CONTROL_MESSAGE_ROLE=system

# 控制提示词注入位置：tail (推荐，末尾强生效), head, system_tail（默认: tail）
CONTROL_MESSAGE_POSITION=tail

# 合成工具前缀：留空时由熵源自行拼接工具名；填写后按“前缀 + 96-bit 随机串”生成
SYNTHETIC_TOOL_PREFIX=

# 请求形态随机化强度：off / light / standard / aggressive（默认: standard）
# off        仅保留唯一性随机，工具名与提示词恢复固定写法
# light      随机化标识符与 JSON 布局
# standard   在 light 基础上随机化控制提示词措辞
# aggressive 在 standard 基础上追加零宽分隔符与采样参数微扰
ENTROPY_LEVEL=standard

# 以下三项留空则跟随 ENTROPY_LEVEL 的默认值，填写 true/false 可单独覆盖
# JSON 键序与空白排版随机化
# ENTROPY_LAYOUT=true
# 网关注入文本中的零宽分隔符（仅作用于网关自身生成的指令，不改动对话内容）
# ENTROPY_INVISIBLE=false
# 采样参数微扰：temperature / top_p 在 ±0.01 内浮动
# ENTROPY_PARAM_JITTER=false

# 固定随机种子（仅用于复现问题，生产环境留空表示每次启动随机）
# ENTROPY_SEED=0

# 出站请求防路由层级：off / wire / standard / deep（默认: wire）
# off       仅做原有传输层改写
# wire      追加非 ASCII 字符的 \uXXXX 转义
# standard  在 wire 基础上净化指令块中的高风险词
# deep      在 standard 基础上拆词掩码、可选降级末尾 assistant 预填，并在响应侧还原
ANTI_ROUTE_LEVEL=wire

# 以下开关留空则跟随 ANTI_ROUTE_LEVEL 的默认值，填写 true/false 可单独覆盖
# \uXXXX 转义非 ASCII 字符
# ANTI_ROUTE_WIRE_ESCAPE=true
# 指令块净化
# ANTI_ROUTE_SCRUB=true
# 拆词掩码（可逆，响应侧自动还原）
# ANTI_ROUTE_SPLIT=false
# 末尾 assistant 预填降级为 user 消息
# ANTI_ROUTE_DEMOTE_PREFILL=false
# 净化范围：leading（仅前导指令块）或 all（全部 system 文本，默认: leading）
# ANTI_ROUTE_SCRUB_SCOPE=leading
# 拆词分隔符：hyphen（-）或 wordjoiner（U+2060，默认: hyphen）
# ANTI_ROUTE_SEPARATOR=hyphen
# 追加规则文件（JSON，含 split_terms / scrub / replace）
# ANTI_ROUTE_RULES_FILE=

# 模型识别结果回传方式：off / headers / body / both（默认: headers）
MODEL_REPORT=headers

# body 回传时使用的字段名（默认: antigravity_model）
# MODEL_REPORT_KEY=antigravity_model

# 是否发送严格 schema（默认: false）
SYNTHETIC_TOOL_STRICT=false

# 包装模式：prefer（默认注入合成协议），required（强制要求合成协议），off（紧急透明透传回滚）
WRAPPER_MODE=prefer

# 格式恢复策略：repair（默认本地确定性修复），repair_then_retry（修复失败后安全单次重试），fail（直接报错）
RECOVERY_POLICY=repair

# 上游空回（完全没有任何输出）时自动重试次数（默认: 3）
UPSTREAM_EMPTY_RETRIES=3

# 高并发与流式缓冲配置
MAX_REQUEST_BYTES=16777216
MAX_RESPONSE_BYTES=16777216
MAX_CONCURRENT_REQUESTS=1024
MAX_CONCURRENT_REQUESTS_PER_KEY=64
REQUEST_QUEUE_TIMEOUT_MS=50
# 流式输出缓冲：默认 0，立即转发；如需兼容特殊上游可显式设置非零值
STREAM_SIDE_BUFFER_BYTES=0
STREAM_REPAIR_BUFFER_BYTES=1048576
STREAM_FLUSH_INTERVAL_MS=0

# 优雅停机与模型缓存
SHUTDOWN_TIMEOUT_MS=30000
MODELS_CACHE_TTL_MS=30000
LOG_LEVEL=info
TRUST_PROXY=false
