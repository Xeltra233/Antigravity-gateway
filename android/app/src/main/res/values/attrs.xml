<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Skin-scoped colors that Material does not expose as semantic attributes. -->
    <attr name="agwLink" format="color" />
    <attr name="agwLogBg" format="color" />
    <attr name="agwSuccess" format="color" />
    <attr name="agwCardBorder" format="color" />
    <attr name="agwTopBar" format="color" />
    <!-- Field rule inside cards; the sketch skin matches it to the card outline weight. -->
    <attr name="agwFieldStroke" format="color" />
    <attr name="agwFieldStrokeWidth" format="dimension" />
    <attr name="agwFieldStrokeWidthFocused" format="dimension" />
    <!-- Hairline between rows: white 10% on the silk, a warm rule on paper. -->
    <attr name="agwDivider" format="color" />
    <!-- Top bar icons and the row chevrons: fixed white/grey tints vanish on the light skins. -->
    <attr name="agwIconTint" format="color" />
    <attr name="agwChevron" format="color" />
    <!-- Switch track: neutral when off so it blends into the page, accent when on. -->
    <attr name="agwSwitchOn" format="color" />
    <attr name="agwSwitchOff" format="color" />
</resources>
