<?xml version="1.0" encoding="utf-8"?>
<!-- acr .cfg.on: rgba(150,175,225,.20) fill with rgba(122,162,255,.62) border, 14px radius, and the
     3px accent bar inset 16px from the top and bottom (the .cfg.on::before pseudo-element).
     The fill carries the blue the browser's backdrop blur would have contributed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4A5493FF" />
            <stroke android:width="1dp" android:color="#9E7AA2FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="left"
        android:top="16dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#7AA2FF" />
            <corners
                android:topRightRadius="3dp"
                android:bottomRightRadius="3dp" />
        </shape>
    </item>
</layer-list>
