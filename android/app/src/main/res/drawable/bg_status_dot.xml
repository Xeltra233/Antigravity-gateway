<?xml version="1.0" encoding="utf-8"?>
<!-- Running indicator: soft halo behind a solid dot. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#334ADE80" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#4ADE80" />
        </shape>
    </item>
</layer-list>
