<?xml version="1.0" encoding="utf-8"?>
<!-- acr .card: rgba(150,175,225,.11) fill, rgba(255,255,255,.13) border, 18px radius.
     Drawn as a plain shape because MaterialCardView composites the semi-transparent
     cardBackgroundColor over the theme surface, which is white here and doubled the brightness. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#335896FF" />
    <stroke android:width="1dp" android:color="#21FFFFFF" />
    <corners android:radius="18dp" />
</shape>
