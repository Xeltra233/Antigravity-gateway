<?xml version="1.0" encoding="utf-8"?>
<!--
    One panel for every dialog in the app. The surface itself is painted at runtime so each skin
    keeps its own material: glass over the ribbon, a card on the flat skins, paper on the sketch one.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelGlass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvGlassTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/tvGlassMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="4dp"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvGlassLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etGlassValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@null"
        android:includeFontPadding="false"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="0dp"
        android:paddingTop="9dp"
        android:paddingEnd="0dp"
        android:paddingBottom="9dp"
        android:singleLine="true"
        android:textSize="15.5sp" />

    <View
        android:id="@+id/viewGlassRule"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <TextView
        android:id="@+id/tvGlassHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutGlassActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnGlassCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/btnGlassConfirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
