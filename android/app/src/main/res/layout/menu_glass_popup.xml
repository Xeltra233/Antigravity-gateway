<?xml version="1.0" encoding="utf-8"?>
<!-- Anchored sheet that the capsule's more button and the capsule long-press both open.
     Rows are added in code so the same panel serves every skin without a layout per theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuGlassPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/menuGlassRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
